{
  "info": {
    "name": "HU-32 — Contenido de landing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Leer contenido público",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/api/public/landing"
      }
    },
    {
      "name": "Leer contenido como Admin/Sacerdote",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/api/landing"
      }
    },
    {
      "name": "Editar contenido como Admin/Sacerdote",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quienes_somos\": {\n    \"descripcion\": \"Somos una comunidad parroquial al servicio de las familias.\"\n  },\n  \"cantidad_grupos\": 15,\n  \"cantidad_espacios\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/landing"
      }
    }
  ]
}
