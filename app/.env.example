# Solicitar el .env por privado

# Frontend
VITE_API_URL=
# Opcional: hostnames extra permitidos por el servidor de Vite (Vite 5 bloquea
# por defecto cualquier Host header que no sea localhost). Necesario para
# probar desde otro dispositivo en la red local, ej: 192.168.1.5
ALLOWED_HOSTS=

# Backend
PORT=
NODE_ENV=

# Base de datos
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# MariaDB Docker
DB_ROOT_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# CORS (origin del frontend, ej: http://localhost:5173 o la IP de producción)
CORS_ORIGIN=

# Adminer
ADMINER_PORT=
